{
  "version": "scalpel-data-v2-qa-only",
  "target_tokens": 100000000,
  "seed": 42,
  "require_native_instruction_pairs": true,
  "max_sequence_tokens": 1536,
  "output": {
    "format": "parquet",
    "shard_rows": 50000,
    "train_ratio": 0.995,
    "validation_ratio": 0.005
  },
  "schema": {
    "id": "string",
    "source": "string",
    "split": "string",
    "group": "english | chinese | math | code",
    "language": "en | zh | code | mix",
    "image": "optional string",
    "conversations": [
      {
        "role": "user",
        "content": "string"
      },
      {
        "role": "assistant",
        "content": "string"
      }
    ],
    "token_estimate": "int",
    "meta": "object"
  },
  "mixture": {
    "english": {
      "ratio": 0.65,
      "sources": [
        {
          "name": "webinstructsub_qa",
          "repo": "TIGER-Lab/WebInstructSub",
          "split": "train",
          "transform": "prompt_response",
          "language": "en",
          "weight": 0.3393,
          "license": "apache-2.0"
        },
        {
          "name": "ultrachat_200k_sft",
          "repo": "HuggingFaceH4/ultrachat_200k",
          "split": "train_sft",
          "transform": "messages",
          "language": "en",
          "weight": 0.21,
          "license": "mit"
        },
        {
          "name": "tulu_3_sft_mixture",
          "repo": "allenai/tulu-3-sft-mixture",
          "split": "train",
          "transform": "messages",
          "language": "mix",
          "weight": 0.3805,
          "license": "odc-by",
          "note": "Mixture contains subsets with different licenses; review before commercial use."
        },
        {
          "name": "medical_o1_qa_en",
          "repo": "FreedomIntelligence/medical-o1-reasoning-SFT",
          "config": "en",
          "split": "train",
          "transform": "medical_qa",
          "language": "en",
          "weight": 0.062,
          "license": "apache-2.0",
          "note": "Uses complete Question->Response only; Complex_CoT is intentionally excluded. Generated medical answers require quality review and are not clinical advice."
        },
        {
          "name": "agieval_dev",
          "repo": "RUCAIBox/agieval",
          "configs": "all",
          "split": "dev",
          "transform": "agieval",
          "language": "mix",
          "weight": 0.0005,
          "license": "mit",
          "note": "Dev examples only; test is excluded. Do not claim AGIEval as an uncontaminated evaluation after training on this source."
        },
        {
          "name": "legal_qa_v1",
          "repo": "dzunggg/legal-qa-v1",
          "split": "train",
          "transform": "native_qa",
          "strip_qa_prefixes": true,
          "language": "en",
          "weight": 0.0077,
          "license": "unspecified",
          "note": "Existing question/answer columns only; upstream dataset declares no license. Restrict to research use until redistribution rights are confirmed. Legal answers are not legal advice."
        }
      ]
    },
    "chinese": {
      "ratio": 0.2,
      "sources": [
        {
          "name": "coig_cqia_full",
          "repo": "m-a-p/COIG-CQIA",
          "split": "train",
          "data_files": "COIG-CQIA-full.jsonl",
          "transform": "prompt_response",
          "language": "zh",
          "weight": 0.32,
          "note": "High-quality Chinese instruction tuning data; check upstream license before redistribution."
        },
        {
          "name": "firefly_train_1m",
          "repo": "YeungNLP/firefly-train-1.1M",
          "split": "train",
          "data_files": "firefly-train-1.1M.jsonl",
          "transform": "prompt_response",
          "language": "zh",
          "weight": 0.25,
          "note": "Chinese multi-task instruction data; review upstream license before redistribution."
        },
        {
          "name": "belle_train_3m_cn",
          "repo": "BelleGroup/train_3.5M_CN",
          "split": "train",
          "transform": "messages",
          "language": "zh",
          "weight": 0.2265,
          "license": "gpl-3.0"
        },
        {
          "name": "medical_o1_qa_zh",
          "repo": "FreedomIntelligence/medical-o1-reasoning-SFT",
          "config": "zh",
          "split": "train",
          "transform": "medical_qa",
          "language": "zh",
          "weight": 0.2,
          "license": "apache-2.0",
          "note": "Uses complete Question->Response only; Complex_CoT is intentionally excluded. Generated medical answers require quality review and are not clinical advice."
        },
        {
          "name": "ceval_dev_exam",
          "repo": "ceval/ceval-exam",
          "loader": "ceval_parquet",
          "split": "dev",
          "transform": "multiple_choice",
          "language": "zh",
          "weight": 0.0025,
          "license": "cc-by-nc-sa-4.0",
          "note": "Use dev only; keep val/test for evaluation."
        },
        {
          "name": "cmmlu_dev_exam",
          "repo": "lmlmcat/cmmlu",
          "loader": "cmmlu_zip",
          "split": "dev",
          "transform": "multiple_choice",
          "language": "zh",
          "weight": 0.001,
          "license": "cc-by-nc-4.0",
          "note": "Use dev only; builder reads cmmlu_v1_0_1.zip directly."
        }
      ]
    },
    "math": {
      "ratio": 0.1,
      "sources": [
        {
          "name": "openr1_math_220k",
          "repo": "open-r1/OpenR1-Math-220k",
          "config": "default",
          "split": "train",
          "transform": "problem_solution",
          "language": "en",
          "weight": 0.1,
          "license": "apache-2.0"
        },
        {
          "name": "numinamath_cot",
          "repo": "AI-MO/NuminaMath-CoT",
          "split": "train",
          "transform": "problem_solution",
          "language": "en",
          "weight": 0.7,
          "license": "apache-2.0"
        },
        {
          "name": "mmlu_auxiliary_train",
          "repo": "cais/mmlu",
          "config": "all",
          "split": "auxiliary_train",
          "transform": "multiple_choice",
          "language": "en",
          "weight": 0.2,
          "license": "mit",
          "note": "Use auxiliary_train only; keep validation/test for evaluation."
        }
      ]
    },
    "code": {
      "ratio": 0.05,
      "sources": [
        {
          "name": "magicoder_oss_instruct_75k",
          "repo": "ise-uiuc/Magicoder-OSS-Instruct-75K",
          "split": "train",
          "data_files": "data-oss_instruct-decontaminated.jsonl",
          "transform": "prompt_response",
          "language": "code",
          "weight": 0.45,
          "license": "mit"
        },
        {
          "name": "magicoder_evol_instruct_110k",
          "repo": "ise-uiuc/Magicoder-Evol-Instruct-110K",
          "split": "train",
          "data_files": "data-evol_instruct-decontaminated.jsonl",
          "transform": "prompt_response",
          "language": "code",
          "weight": 0.35,
          "license": "apache-2.0"
        },
        {
          "name": "self_oss_instruct_exec_filter_50k",
          "repo": "bigcode/self-oss-instruct-sc2-exec-filter-50k",
          "split": "train",
          "transform": "prompt_response",
          "language": "code",
          "weight": 0.2,
          "license": "odc-by"
        }
      ]
    }
  }
}